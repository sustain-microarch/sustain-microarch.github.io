source "https://rubygems.org"

# The `github-pages` gem is the standard way to install Jekyll and all
# plugins (including the Cayman theme) for local development, so that the
# local build matches what GitHub Pages runs. It provides jekyll,
# jekyll-theme-cayman, jekyll-seo-tag, jekyll-sitemap and
# jekyll-relative-links (see plugins in _config.yml).
gem "github-pages", group: :jekyll_plugins

# Windows does not include zoneinfo files, so bundle the tzinfo-data gem
# and a performance-optimized time zone database.
gem "tzinfo-data", platforms: %i[mingw mswin x64_mingw jruby]

# Reduces the time it takes to boot Jekyll on Windows.
gem "wdm", "~> 0.1.1", platforms: %i[mingw mswin x64_mingw]
